#!/bin/bash
# PiVista control: pivista {start|stop|restart|enable|disable|status|logs|uninstall}
set -e
need_root() { [ "$(id -u)" = 0 ] || exec sudo "$0" "$@"; }
case "$1" in
  start)     need_root "$@"; systemctl start pivista pivista-kiosk ;;
  stop)      need_root "$@"; systemctl stop pivista-kiosk ;;
  restart)   need_root "$@"; systemctl restart pivista pivista-kiosk ;;
  enable)    need_root "$@"; /opt/pivista/system/autostart.sh on
             sed -i 's/"autostart": false/"autostart": true/' /var/lib/pivista/settings.json 2>/dev/null || true
             echo "PiVista will start on boot." ;;
  disable)   need_root "$@"; /opt/pivista/system/autostart.sh off
             sed -i 's/"autostart": true/"autostart": false/' /var/lib/pivista/settings.json 2>/dev/null || true
             echo "PiVista will not start on boot (server + remote stay available)." ;;
  status)    systemctl --no-pager status pivista pivista-kiosk ;;
  logs)      journalctl -u pivista -u pivista-kiosk -f ;;
  uninstall) need_root "$@"; /opt/pivista/scripts/uninstall.sh ;;
  *) echo "usage: pivista {start|stop|restart|enable|disable|status|logs|uninstall}"; exit 1 ;;
esac
