{
  "name": "pivista",
  "version": "0.3.2",
  "description": "PiVista - turn any HDMI monitor into a smart TV with a Raspberry Pi 4 and your phone as the remote.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "PIVISTA_PORT=8080 PIVISTA_DATA=./.data PIVISTA_DEV=1 node server/index.js",
    "check": "node --check server/*.js && node scripts/selftest.js"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
